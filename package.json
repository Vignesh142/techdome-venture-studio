{
  "name": "techdome-redesign",
  "version": "1.0.0",
  "private": true,
  "description": "Techdome Venture Studio Redesign with Headless CMS",
  "scripts": {
    "dev:cms": "node cms/server.js",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently -n \"CMS,FRONTEND\" -c \"magenta,cyan\" \"npm run dev:cms\" \"npm run dev:frontend\"",
    "build": "cd frontend && npm run build",
    "start": "node cms/server.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
